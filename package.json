{
  "name": "trustcore-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static site build tooling for trustcore.es",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./site/assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./site/assets/css/tailwind.min.css --watch"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "tailwindcss": "^3.4.19"
  }
}
