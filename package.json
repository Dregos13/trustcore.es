{
  "name": "trustcore-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static site build tooling for trustcore.es",
  "scripts": {
    "build": "node scripts/build-assets.mjs && node scripts/seo-i18n.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:images": "node scripts/build-images.mjs",
    "build:posters": "node scripts/build-video-posters.mjs",
    "build:seo": "node scripts/aprende-videos.mjs && node scripts/seo-i18n.mjs",
    "serve": "cd site && python3 -m http.server 8471 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  }
}
